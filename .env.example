# Runtime role (limited grants), and separately the direct migration/owner role.
DATABASE_URL=postgresql://siteguard:local-dev-only@127.0.0.1:5432/siteguard
MIGRATION_DATABASE_URL=postgresql://postgres:local-dev-only@127.0.0.1:5432/siteguard
# Generate a separate value per environment with: openssl rand -base64 48
SITEGUARD_SECRET=
# Optional canonical HTTPS origin for administrative requests and identity redirects.
SITEGUARD_ORIGIN=
# Comma-separated prior roots during a controlled key rotation.
SITEGUARD_PREVIOUS_SECRETS=
# Required before any site can enable image evidence. See security/privacy guide.
SITEGUARD_EVIDENCE_ENABLED=false
# Optional SSO. Set all three variables and SITEGUARD_ORIGIN to enable.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Enable daily image/session retention cleanup on Vercel. Generate a separate high-entropy value.
CRON_SECRET=
