# Runtime role (limited grants), and separately the direct migration/owner role.
DATABASE_URL=postgresql://siteguard:local-dev-only@127.0.0.1:5432/siteguard
MIGRATION_DATABASE_URL=postgresql://postgres:local-dev-only@127.0.0.1:5432/siteguard
# Generate a separate value per environment with: openssl rand -base64 48
SITEGUARD_SECRET=
# Optional canonical HTTPS origin for administrative requests and identity redirects.
SITEGUARD_ORIGIN=
